<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Mes heures de travail</title>

<style>

body{font-family:Arial;background:#f3f4f8;padding:18px;color:#222}

.card{background:white;padding:20px;border-radius:18px;margin-bottom:15px}

h1{text-align:center;color:#344c75}

label{display:block;margin-top:14px}

input{width:100%;padding:12px;margin-top:6px;box-sizing:border-box;border:1px solid #ccc;border-radius:9px;font-size:17px}

button{width:100%;padding:14px;background:#344c75;color:white;border:0;border-radius:10px;margin-top:18px;font-size:17px}

.result{text-align:center;font-size:21px;font-weight:bold;margin:15px 0}

.entry{padding:12px;border-bottom:1px solid #ddd}

</style>

</head>

<body>

<h1>⏰ Mes heures de travail</h1>

<div class="card">

<h2>Mon suivi quotidien</h2>

<label>Date</label>

<input type="date" id="date">

<label>Heure d'arrivée</label>

<input type="time" id="start" min="07:00" max="18:00" value="09:00">